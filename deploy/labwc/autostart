#!/bin/sh
# labwc runs this once the compositor is up.
#
# Order matters. seshd is started from inside this session (not as a system
# service) so that every app it later spawns — Kodi, RetroArch, Moonlight —
# inherits WAYLAND_DISPLAY and XDG_RUNTIME_DIR and actually appears on the TV.

# Hand this session's Wayland environment to the user systemd manager, then
# activate the target the units hang off.
#
# The import must come first and the ordering is the whole point: a unit
# inherits the manager's environment as it stood when the unit started, so
# anything pulled in before this line would come up with no WAYLAND_DISPLAY and
# every app it spawned would have nowhere to appear.
#
# The target is ours rather than graphical-session.target, which nothing here
# activates and nothing can: it is RefuseManualStart=yes, so `systemctl --user
# start graphical-session.target` is refused outright. Units hung off it are
# decorative — `enable` reports success, writes a symlink into a target that
# never runs, and starts nothing. That was the state this box was found in.
systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR
systemctl --user start sesh-session.target

# Wait for seshd to accept connections before pointing the browser at it,
# so the kiosk never lands on a connection-refused page.
i=0
while [ "$i" -lt 50 ]; do
    if curl -sf http://127.0.0.1:7373/api/apps >/dev/null 2>&1; then
        break
    fi
    i=$((i + 1))
    sleep 0.2
done

# Package name differs across Raspberry Pi OS releases.
if command -v chromium-browser >/dev/null 2>&1; then
    CHROMIUM=chromium-browser
else
    CHROMIUM=chromium
fi

# The kiosk gets its own Chromium profile and never shares the user's default
# one. Sharing it is not a tidiness concern — it is a hard boot failure. A
# SingletonLock left in ~/.config/chromium by any earlier desktop Chromium
# encodes the hostname that created it, and Chromium refuses to touch a profile
# locked by "another computer". Rename the Pi (raspberrypi -> TatePi, as the
# stock image invites) and that lock becomes permanent: Chromium exits 21
# before painting anything, tries to report it through a modal that has no
# display to appear on, and leaves a black screen with a live mouse cursor and
# no visible cause. A dedicated profile is never touched by a desktop session,
# so the collision cannot arise.
KIOSK_PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/sesh/chromium"
mkdir -p "$KIOSK_PROFILE"

# Belt and braces for the unclean-shutdown case. A same-host stale lock does
# self-heal — Chromium checks whether the recorded pid is alive — but a lock
# written under a previous hostname never will. Pulling the plug on a room
# appliance is normal use, so clear the lock when no kiosk is running rather
# than let a power cut plus a later rename brick the screen.
if ! pgrep -f "user-data-dir=$KIOSK_PROFILE" >/dev/null 2>&1; then
    rm -f "$KIOSK_PROFILE"/Singleton*
fi

# --password-store=basic: without it Chromium asks gnome-keyring to unlock,
# which throws a modal "Unlock Keyring — Authentication required" dialog over
# the kiosk. There is no keyboard on a TV to dismiss it, so the room is stuck.
"$CHROMIUM" \
    --kiosk \
    --ozone-platform=wayland \
    --enable-features=UseOzonePlatform \
    --user-data-dir="$KIOSK_PROFILE" \
    --password-store=basic \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --check-for-update-interval=31536000 \
    --autoplay-policy=no-user-gesture-required \
    http://127.0.0.1:7373 &

# Music output, started last and deliberately after the kiosk.
#
# `systemctl --user start` returns as soon as the process is spawned, so this
# cannot delay anything — but the kiosk's patience above is a fixed 10.48s
# budget that a slow start would eat into, and PR #18 is the record of what
# happens when something is put in front of it. Nothing goes before Chromium
# that does not have to.
#
# librespot advertises a Spotify Connect device named SESH; seshd moves
# playback onto it over the Web API. With no speaker paired its PULSE_SINK is
# unset and the music comes out of the TV.
#
# Started here rather than pulled in by the target above, and its unit has no
# [Install] section so it cannot be enabled into one by mistake. Ordering is
# the reason: a `WantedBy=graphical-session.target` would start it before
# Chromium, and the kiosk's patience is a fixed 10.48s budget. That is #18.
systemctl --user start sesh-librespot.service 2>/dev/null || true
